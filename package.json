{
  "name": "teyvat-scriptorium",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:fetch": "node scripts/fetch-quest.mjs 1700",
    "data:catalog": "node --use-env-proxy scripts/fetch-catalog.mjs",
    "data:hangouts": "node --use-env-proxy scripts/fetch-hangouts.mjs",
    "data:update": "npm run data:catalog && npm run data:hangouts && npm run data:fetch",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:print": "npm run build && node scripts/qa-print.mjs",
    "qa:dialogue": "npm run build && node scripts/qa-dialogue.mjs",
    "qa:navigation": "npm run build && node scripts/qa-navigation.mjs",
    "qa:catalog": "npm run build && node scripts/qa-catalog.mjs",
    "qa:hangout": "node --use-env-proxy scripts/qa-hangout.mjs",
    "qa:branches": "node scripts/qa-branches.mjs",
    "qa:reader-layout": "node scripts/qa-reader-layout.mjs",
    "publish:pages": "npm test && npm run build && wrangler pages deploy ./dist --project-name teyvat-scriptorium --branch main",
    "publish": "git push origin main && npm run publish:pages"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "latest",
    "@fontsource/noto-serif-sc": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "playwright": "^1.62.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
